{%- comment -%}
  Book Plume — Apple-style hero section
  Signature element: fixed left "spine rail" — tick marks with rotated
  labels imitating book spines on a shelf, doubling as anchor nav.
{%- endcomment -%}

{% style %}
  @import url('https://api.fontshare.com/v2/css?f[]=general-sans@500,600,700&display=swap');
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=IBM+Plex+Mono:wght@500&display=swap');

  .hero-bp-{{ section.id }} {
    --bp-paper: {{ section.settings.color_background }};
    --bp-ink: {{ section.settings.color_text }};
    --bp-graphite: #4A4642;
    --bp-accent: {{ section.settings.color_accent }};
    --bp-hairline: #E4E1DC;

    position: relative;
    background: var(--bp-paper);
    color: var(--bp-ink);
    padding: 0;
    overflow: hidden;
  }

  .hero-bp-{{ section.id }} .hero-bp__inner {
    max-width: 980px;
    margin: 0 auto;
    padding: 96px 24px 64px;
    text-align: center;
  }

  .hero-bp-{{ section.id }} .hero-bp__eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bp-graphite);
    margin: 0 0 28px;
    opacity: 0;
    animation: hero-bp-fade-up 0.7s ease forwards;
    animation-delay: 0.05s;
  }

  .hero-bp-{{ section.id }} .hero-bp__heading {
    font-family: 'General Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 600;
    font-size: clamp(40px, 7vw, 84px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: 0 0 24px;
    opacity: 0;
    animation: hero-bp-fade-up 0.7s ease forwards;
    animation-delay: 0.15s;
  }

  .hero-bp-{{ section.id }} .hero-bp__subheading {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.5;
    color: var(--bp-graphite);
    max-width: 560px;
    margin: 0 auto 40px;
    opacity: 0;
    animation: hero-bp-fade-up 0.7s ease forwards;
    animation-delay: 0.25s;
  }

  .hero-bp-{{ section.id }} .hero-bp__actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    opacity: 0;
    animation: hero-bp-fade-up 0.7s ease forwards;
    animation-delay: 0.35s;
  }

  .hero-bp-{{ section.id }} .hero-bp__btn {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 500;
    padding: 13px 26px;
    border-radius: 100px;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease, opacity 0.2s ease;
    display: inline-block;
  }

  .hero-bp-{{ section.id }} .hero-bp__btn--primary {
    background: var(--bp-accent);
    color: #FAFAF8;
  }

  .hero-bp-{{ section.id }} .hero-bp__btn--primary:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  .hero-bp-{{ section.id }} .hero-bp__btn--secondary {
    color: var(--bp-ink);
    padding: 13px 4px;
  }

  .hero-bp-{{ section.id }} .hero-bp__btn--secondary:hover {
    color: var(--bp-accent);
  }

  .hero-bp-{{ section.id }} .hero-bp__banner {
    width: 100%;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    background: var(--bp-hairline);
  }

  .hero-bp-{{ section.id }} .hero-bp__banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Signature element: spine rail */
  .hero-bp-{{ section.id }} .hero-bp__spine-rail {
    position: fixed;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 28px;
    align-items: flex-start;
  }

  .hero-bp-{{ section.id }} .hero-bp__spine-item {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--bp-graphite);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .hero-bp-{{ section.id }} .hero-bp__spine-tick {
    width: 18px;
    height: 2px;
    background: var(--bp-hairline);
    transition: width 0.2s ease, background 0.2s ease;
  }

  .hero-bp-{{ section.id }} .hero-bp__spine-item span {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    max-height: 90px;
    overflow: hidden;
  }

  .hero-bp-{{ section.id }} .hero-bp__spine-item:hover {
    color: var(--bp-accent);
  }

  .hero-bp-{{ section.id }} .hero-bp__spine-item:hover .hero-bp__spine-tick {
    width: 28px;
    background: var(--bp-accent);
  }

  @keyframes hero-bp-fade-up {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 989px) {
    .hero-bp-{{ section.id }} .hero-bp__spine-rail {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bp-{{ section.id }} .hero-bp__eyebrow,
    .hero-bp-{{ section.id }} .hero-bp__heading,
    .hero-bp-{{ section.id }} .hero-bp__subheading,
    .hero-bp-{{ section.id }} .hero-bp__actions {
      animation: none;
      opacity: 1;
    }
  }
{% endstyle %}

<div class="hero-bp-{{ section.id }}">

  {%- if section.blocks.size > 0 -%}
  <nav class="hero-bp__spine-rail" aria-label="Shop by category">
    {%- for block in section.blocks -%}
      {%- if block.type == 'spine_item' -%}
        <a href="{{ block.settings.link | default: '#' }}" class="hero-bp__spine-item" {{ block.shopify_attributes }}>
          <span class="hero-bp__spine-tick" aria-hidden="true"></span>
          <span>{{ block.settings.label }}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </nav>
  {%- endif -%}

  <div class="hero-bp__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero-bp__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="hero-bp__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div class="hero-bp__subheading">{{ section.settings.subheading }}</div>
    {%- endif -%}

    <div class="hero-bp__actions">
      {%- if section.settings.primary_label != blank -%}
        <a href="{{ section.settings.primary_link | default: '#' }}" class="hero-bp__btn hero-bp__btn--primary">
          {{ section.settings.primary_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a href="{{ section.settings.secondary_link | default: '#' }}" class="hero-bp__btn hero-bp__btn--secondary">
          {{ section.settings.secondary_label }} →
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.banner_image != blank -%}
    <div class="hero-bp__banner">
      {{ section.settings.banner_image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '750,1100,1500,2400' }}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Apple-style Hero",
  "tag": "section",
  "class": "section hero-bp-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Book Plume · Brooklyn, NY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Books people actually open."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Study guides that get you through finals. Coloring pages that get you through Tuesday. Bibles that get you through anything.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop bestsellers"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Browse categories"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background color",
      "default": "#FAFAF8"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text color",
      "default": "#111110"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent color (spine red)",
      "default": "#B23A2E"
    }
  ],
  "blocks": [
    {
      "type": "spine_item",
      "name": "Spine rail item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Apple-style Hero",
      "blocks": [
        { "type": "spine_item", "settings": { "label": "Anatomy & Medical" } },
        { "type": "spine_item", "settings": { "label": "Coloring & Journals" } },
        { "type": "spine_item", "settings": { "label": "Bible & Faith" } },
        { "type": "spine_item", "settings": { "label": "Español" } }
      ]
    }
  ]
}
{% endschema %}
