{%- comment -%}
  Book Plume — "Buy now" button.

  Sends the selected variant straight to checkout via a cart permalink,
  with the current promo code already applied. Replaces Shopify's dynamic
  checkout button, whose wording and colour cannot be changed.

  On load the button relocates itself into .product-form__buttons so it
  sits directly beneath Add to cart with a single controlled gap, rather
  than a section-block margin we cannot predict.
{%- endcomment -%}

{%- assign v = product.selected_or_first_available_variant -%}
{%- assign promo = 'AUGUST15' -%}

<div class="bp-buynow-slot">
  {%- if v.available -%}
    <a
      class="bp-buynow"
      href="{{ routes.cart_url }}/{{ v.id }}:1?discount={{ promo }}"
      data-bp-buynow
      data-cart-root="{{ routes.cart_url }}"
      data-promo="{{ promo }}"
    >Buy now</a>
  {%- else -%}
    <span class="bp-buynow" aria-disabled="true">Sold out</span>
  {%- endif -%}
</div>

<script>
  (function () {
    var slot = document.currentScript.previousElementSibling;
    while (slot && !slot.classList.contains('bp-buynow-slot')) {
      slot = slot.previousElementSibling;
    }
    if (!slot) return;

    var btn = slot.querySelector('.bp-buynow');
    if (!btn) return;

    // Move the button next to Add to cart
    var host = document.querySelector('.product-form__buttons');
    if (host && !host.contains(btn)) {
      host.appendChild(btn);
      slot.remove();
    }

    if (btn.tagName !== 'A') return;

    var root = btn.getAttribute('data-cart-root') || '/cart';
    var promo = btn.getAttribute('data-promo') || '';

    function sync() {
      var form = document.querySelector('product-form form, form[action*="/cart/add"]');
      if (!form) return;
      var idField = form.querySelector('[name="id"]');
      if (!idField || !idField.value) return;

      var qtyField = document.querySelector('.quantity__input, [name="quantity"]');
      var qty = 1;
      if (qtyField) {
        var parsed = parseInt(qtyField.value, 10);
        if (parsed > 0) qty = parsed;
      }

      var url = root + '/' + idField.value + ':' + qty;
      if (promo) url += '?discount=' + promo;
      btn.href = url;
    }

    sync();
    document.addEventListener('change', sync);
    document.addEventListener('input', sync);
  })();
</script>
