{%- comment -%}
  Book Plume — product promo banner + trust badges.
  Sits directly under the buy button on product pages.
{%- endcomment -%}

{%- style -%}
  .bp-promo-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .bp-promo__banner {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    background: {{ section.settings.promo_bg }};
    color: {{ section.settings.promo_text }};
    border-radius: 16px;
    padding: 1.8rem 2rem;
    text-decoration: none;
    margin-bottom: 2rem;
  }

  .bp-promo__badge {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_text }};
    font-family: var(--font-heading-family);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .bp-promo__copy {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .bp-promo__title {
    font-family: var(--font-heading-family);
    font-size: 1.7rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .bp-promo__sub {
    font-size: 1.3rem;
    opacity: 0.88;
    line-height: 1.35;
  }

  .bp-promo__badges {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem 1.2rem;
  }

  @media screen and (min-width: 750px) {
    .bp-promo__badges {
      grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 4 }}, 1fr);
    }
  }

  .bp-promo__item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .bp-promo__icon {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: {{ section.settings.icon_bg }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .bp-promo__icon svg {
    width: 19px;
    height: 19px;
    stroke: {{ section.settings.icon_color }};
    fill: none;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .bp-promo__item-title {
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.25;
    margin: 0.3rem 0 0.2rem;
  }

  .bp-promo__item-text {
    font-size: 1.2rem;
    opacity: 0.7;
    line-height: 1.35;
    margin: 0;
  }
{%- endstyle -%}

<div class="bp-promo-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.promo_title != blank -%}
      {%- if section.settings.promo_link != blank -%}
        <a href="{{ section.settings.promo_link }}" class="bp-promo__banner">
      {%- else -%}
        <div class="bp-promo__banner">
      {%- endif -%}
        {%- if section.settings.promo_badge != blank -%}
          <span class="bp-promo__badge">{{ section.settings.promo_badge }}</span>
        {%- endif -%}
        <span class="bp-promo__copy">
          <span class="bp-promo__title">{{ section.settings.promo_title }}</span>
          {%- if section.settings.promo_sub != blank -%}
            <span class="bp-promo__sub">{{ section.settings.promo_sub }}</span>
          {%- endif -%}
        </span>
      {%- if section.settings.promo_link != blank -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="bp-promo__badges">
        {%- for block in section.blocks -%}
          <div class="bp-promo__item" {{ block.shopify_attributes }}>
            <span class="bp-promo__icon">
              {%- case block.settings.icon -%}
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 7h11v10H2zM13 10h4l4 4v3h-8z"/><circle cx="6.5" cy="17.5" r="2"/><circle cx="17.5" cy="17.5" r="2"/></svg>
                {%- when 'return' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10a9 9 0 1 1 2 6"/><path d="M3 5v5h5"/></svg>
                {%- when 'lock' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                {%- when 'stack' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 3 7.5 12 12l9-4.5z"/><path d="M3 12.5 12 17l9-4.5"/><path d="M3 17 12 21.5 21 17"/></svg>
                {%- when 'star' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg>
                {%- when 'gift' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="9" width="18" height="12" rx="2"/><path d="M3 13h18M12 9v12"/><path d="M12 9S9.5 3 7 5s5 4 5 4M12 9s2.5-6 5-4-5 4-5 4"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg>
              {%- endcase -%}
            </span>
            <span>
              <p class="bp-promo__item-title">{{ block.settings.title }}</p>
              {%- if block.settings.text != blank -%}
                <p class="bp-promo__item-text">{{ block.settings.text }}</p>
              {%- endif -%}
            </span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Product promo",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Promo banner"
    },
    {
      "type": "text",
      "id": "promo_badge",
      "label": "Badge text",
      "default": "-10%"
    },
    {
      "type": "text",
      "id": "promo_title",
      "label": "Headline",
      "default": "Buy any 3 books, save 10%"
    },
    {
      "type": "text",
      "id": "promo_sub",
      "label": "Subtext",
      "default": "Discount applies automatically at checkout \u2014 no code needed."
    },
    {
      "type": "url",
      "id": "promo_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "promo_bg",
      "label": "Banner background",
      "default": "#5C7A2F"
    },
    {
      "type": "color",
      "id": "promo_text",
      "label": "Banner text",
      "default": "#F7FBEE"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge background",
      "default": "#F2D14E"
    },
    {
      "type": "color",
      "id": "badge_text",
      "label": "Badge text color",
      "default": "#2A2410"
    },
    {
      "type": "header",
      "content": "Trust badges"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Icon background",
      "default": "#E6E9D2"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#5C7A2F"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Shipping truck" },
            { "value": "return", "label": "Returns arrow" },
            { "value": "lock", "label": "Secure lock" },
            { "value": "stack", "label": "Book stack" },
            { "value": "star", "label": "Star" },
            { "value": "gift", "label": "Gift" },
            { "value": "check", "label": "Check" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fast shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Subtext",
          "default": "Ships in 1\u20132 business days"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product promo",
      "blocks": [
        { "type": "badge" },
        { "type": "badge" },
        { "type": "badge" }
      ]
    }
  ]
}
{% endschema %}
