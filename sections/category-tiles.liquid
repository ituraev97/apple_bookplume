{%- comment -%}
  Book Plume — category tiles with built-in vector illustrations.
  Horizontally scrollable rail; Matcha + Banana palette.
{%- endcomment -%}

{%- style -%}
  .bp-cats-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .bp-cats__rail {
    display: flex;
    gap: 1.4rem;
    list-style: none;
    padding: 0 1.5rem 0.8rem;
    margin: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(var(--color-foreground), 0.2) transparent;
  }

  .bp-cats__rail::-webkit-scrollbar { height: 4px; }
  .bp-cats__rail::-webkit-scrollbar-thumb {
    background: rgba(var(--color-foreground), 0.18);
    border-radius: 4px;
  }
  .bp-cats__rail::-webkit-scrollbar-track { background: transparent; }

  .bp-cats__item {
    flex: 0 0 auto;
    width: {{ section.settings.tile_size }}px;
    scroll-snap-align: start;
  }

  .bp-cats__item a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .bp-cats__art {
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bp-cats__art svg { display: block; width: 100%; height: 100%; }

  .bp-cats__item a:hover .bp-cats__art { transform: translateY(-4px); }

  .bp-cats__label {
    margin: 1rem 0 0;
    font-family: var(--font-heading-family);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .bp-cats__count {
    display: block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.5;
    margin-top: 0.3rem;
  }

  .bp-cats__heading { margin: 0 0 2.4rem; }

  @media screen and (min-width: 750px) {
    .bp-cats__rail { gap: 2rem; padding-inline: 5rem; }
    .bp-cats__item { width: {{ section.settings.tile_size | plus: 40 }}px; }
    .bp-cats__label { font-size: 1.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bp-cats__art { transition: none; }
    .bp-cats__rail { scroll-snap-type: none; }
  }
{%- endstyle -%}

<div class="bp-cats-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  {%- if section.settings.title != blank -%}
    <div class="page-width">
      <h2 class="bp-cats__heading {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
    </div>
  {%- endif -%}

  <ul class="bp-cats__rail" role="list">
    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      <li class="bp-cats__item" {{ block.shopify_attributes }}>
        <a href="{% if col != blank %}{{ col.url }}{% else %}{{ routes.collections_url }}{% endif %}">
          <div class="bp-cats__art">
            {%- case block.settings.art -%}
              {%- when 'anatomy' -%}
                <svg viewBox="0 0 200 200" role="img" aria-label="Anatomy and medical study books">
                  <rect width="200" height="200" fill="#5C7A2F"/>
                  <circle cx="148" cy="46" r="58" fill="#6E8F3C"/>
                  <g stroke="#F7FBEE" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M100 40C78 40 64 57 64 77c0 15 8 22 8 34h56c0-12 8-19 8-34 0-20-14-37-36-37Z"/>
                    <circle cx="86" cy="75" r="7" fill="#F2D14E" stroke="none"/>
                    <circle cx="114" cy="75" r="7" fill="#F2D14E" stroke="none"/>
                    <path d="M93 92l7 9 7-9"/>
                    <path d="M72 119h56M80 119v42M120 119v42M80 132h40M80 146h40M80 160h40"/>
                  </g>
                </svg>
              {%- when 'coloring' -%}
                <svg viewBox="0 0 200 200" role="img" aria-label="Coloring books and journals">
                  <rect width="200" height="200" fill="#F2D14E"/>
                  <circle cx="36" cy="170" r="52" fill="#E7C13A"/>
                  <g fill="none" stroke="#5C7A2F" stroke-width="3.4" stroke-linecap="round">
                    <circle cx="100" cy="92" r="17"/>
                    <path d="M100 75c0-26-25-30-31-15-6 15 13 21 31 15Z"/>
                    <path d="M100 75c0-26 25-30 31-15 6 15-13 21-31 15Z"/>
                    <path d="M100 109c0 26-25 30-31 15-6-15 13-21 31-15Z"/>
                    <path d="M100 109c0 26 25 30 31 15 6-15-13-21-31-15Z"/>
                  </g>
                  <g fill="none" stroke="#1F2A14" stroke-width="3.4" stroke-linecap="round">
                    <path d="M83 92c-26 0-30-25-15-31"/>
                    <path d="M117 92c26 0 30 25 15 31"/>
                    <path d="M44 152c19-13 34 2 46-6 12-8 27 7 46-4"/>
                  </g>
                  <circle cx="100" cy="92" r="6" fill="#1F2A14"/>
                </svg>
              {%- when 'bible' -%}
                <svg viewBox="0 0 200 200" role="img" aria-label="Bible and faith books">
                  <rect width="200" height="200" fill="#1F2A14"/>
                  <circle cx="100" cy="58" r="46" fill="#2B3A1C"/>
                  <g stroke="#F7FBEE" stroke-width="3.2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M100 40v46M79 60h42"/>
                    <path d="M42 116c15-9 36-9 58 0 22-9 43-9 58 0v44c-15-9-36-9-58 0-22-9-43-9-58 0Z"/>
                    <path d="M100 116v44"/>
                  </g>
                  <circle cx="100" cy="28" r="6" fill="#F2D14E"/>
                </svg>
              {%- when 'spanish' -%}
                <svg viewBox="0 0 200 200" role="img" aria-label="Spanish language books">
                  <rect width="200" height="200" fill="#E6E3CF"/>
                  <path d="M0 200 L200 60 L200 200Z" fill="#DAD6BE"/>
                  <g stroke="#1F2A14" stroke-width="3.2" fill="none" stroke-linejoin="round">
                    <rect x="40" y="52" width="78" height="74" rx="4" fill="#F7FBEE"/>
                    <path d="M40 52v74" stroke="#5C7A2F" stroke-width="9"/>
                    <path d="M58 74h44M58 89h44M58 104h26" stroke-linecap="round"/>
                  </g>
                  <path d="M104 128h56v34h-16l-10 12v-12h-30Z" fill="#F2D14E"/>
                  <text x="132" y="151" text-anchor="middle" fill="#2A2410" font-family="system-ui, sans-serif" font-size="16" font-weight="700">Hola</text>
                </svg>
              {%- when 'boxed' -%}
                <svg viewBox="0 0 200 200" role="img" aria-label="Boxed sets and series">
                  <rect width="200" height="200" fill="#2B3A1C"/>
                  <circle cx="166" cy="172" r="56" fill="#354826"/>
                  <g>
                    <rect x="46" y="52" width="20" height="100" rx="3" fill="#F7FBEE"/>
                    <rect x="70" y="44" width="20" height="108" rx="3" fill="#F2D14E"/>
                    <rect x="94" y="58" width="20" height="94" rx="3" fill="#A8BE7A"/>
                    <rect x="118" y="48" width="20" height="104" rx="3" fill="#F7FBEE"/>
                    <rect x="36" y="150" width="112" height="12" rx="3" fill="#141C0C"/>
                  </g>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 200 200" role="img" aria-label="Book category">
                  <rect width="200" height="200" fill="#EEEDDC"/>
                  <g stroke="#1F2A14" stroke-width="3.2" fill="none" stroke-linejoin="round">
                    <path d="M40 62c18-8 42-8 60 0 18-8 42-8 60 0v78c-18-8-42-8-60 0-18-8-42-8-60 0Z" fill="#F7FBEE"/>
                    <path d="M100 62v78"/>
                  </g>
                </svg>
            {%- endcase -%}
          </div>
          <p class="bp-cats__label">
            {%- if block.settings.label != blank -%}
              {{ block.settings.label }}
            {%- elsif col != blank -%}
              {{ col.title }}
            {%- else -%}
              Category
            {%- endif -%}
            {%- if section.settings.show_count and col != blank -%}
              <span class="bp-cats__count">{{ col.products_count }} titles</span>
            {%- endif -%}
          </p>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Category tiles",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Shop by category",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "range",
      "id": "tile_size",
      "min": 100,
      "max": 220,
      "step": 10,
      "unit": "px",
      "label": "Tile size on mobile",
      "info": "Desktop tiles are 40px wider.",
      "default": 140
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "default": true,
      "label": "Show product count"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label override",
          "info": "Leave blank to use the collection title."
        },
        {
          "type": "select",
          "id": "art",
          "label": "Illustration",
          "options": [
            { "value": "anatomy", "label": "Anatomy & medical" },
            { "value": "coloring", "label": "Coloring & journals" },
            { "value": "bible", "label": "Bible & faith" },
            { "value": "spanish", "label": "Spanish language" },
            { "value": "boxed", "label": "Boxed sets" },
            { "value": "generic", "label": "Generic book" }
          ],
          "default": "generic"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
