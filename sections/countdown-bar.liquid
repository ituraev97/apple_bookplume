{%- comment -%}
  Book Plume — countdown bar.
  Counts down to a real end date set in the theme editor. When the
  date passes the whole section disappears, so the store never shows
  an expired or looping timer.
{%- endcomment -%}

{%- style -%}
  .bp-count-{{ section.id }} {
    padding: {{ section.settings.padding }}px 0;
  }

  .bp-count__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .bp-count__copy {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .bp-count__lead {
    font-family: var(--font-heading-family);
    font-size: 1.8rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .bp-count__sub {
    font-size: 1.4rem;
    opacity: 0.8;
  }

  .bp-count__clock {
    display: flex;
    gap: 2.4rem;
    align-items: baseline;
  }

  .bp-count__unit {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }

  .bp-count__num {
    font-family: var(--font-heading-family);
    font-size: clamp(2.6rem, 4vw, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .bp-count__lbl {
    font-family: var(--font-mono-family);
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  @media screen and (max-width: 749px) {
    .bp-count__inner {
      justify-content: center;
      text-align: center;
      gap: 1.4rem;
    }
    .bp-count__copy { align-items: center; }
    .bp-count__clock { gap: 1.6rem; }
  }
{%- endstyle -%}

{%- if section.settings.end_date != blank -%}
  <div
    class="bp-count-{{ section.id }} color-{{ section.settings.color_scheme }} gradient"
    data-bp-countdown
    data-end="{{ section.settings.end_date }}T{{ section.settings.end_time | default: '23:59' }}:00"
    hidden
  >
    <div class="page-width bp-count__inner">
      <span class="bp-count__copy">
        <span class="bp-count__lead">{{ section.settings.heading }}</span>
        {%- if section.settings.subtext != blank -%}
          <span class="bp-count__sub">{{ section.settings.subtext }}</span>
        {%- endif -%}
      </span>
      <span class="bp-count__clock">
        <span class="bp-count__unit"><span class="bp-count__num" data-d>0</span><span class="bp-count__lbl">Days</span></span>
        <span class="bp-count__unit"><span class="bp-count__num" data-h>00</span><span class="bp-count__lbl">Hours</span></span>
        <span class="bp-count__unit"><span class="bp-count__num" data-m>00</span><span class="bp-count__lbl">Min</span></span>
        <span class="bp-count__unit"><span class="bp-count__num" data-s>00</span><span class="bp-count__lbl">Sec</span></span>
      </span>
    </div>
  </div>

  <script>
    (function () {
      var el = document.currentScript.previousElementSibling;
      while (el && !el.hasAttribute('data-bp-countdown')) el = el.previousElementSibling;
      if (!el) return;

      var end = new Date(el.getAttribute('data-end')).getTime();
      if (isNaN(end)) return;

      var d = el.querySelector('[data-d]'), h = el.querySelector('[data-h]'),
          m = el.querySelector('[data-m]'), s = el.querySelector('[data-s]');

      function pad(n) { return n < 10 ? '0' + n : String(n); }

      function tick() {
        var left = end - Date.now();
        if (left <= 0) { el.remove(); return; }
        el.hidden = false;
        var sec = Math.floor(left / 1000);
        d.textContent = Math.floor(sec / 86400);
        h.textContent = pad(Math.floor(sec % 86400 / 3600));
        m.textContent = pad(Math.floor(sec % 3600 / 60));
        s.textContent = pad(sec % 60);
      }

      tick();
      setInterval(tick, 1000);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Countdown bar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Set the real end date of your promotion. The bar hides itself once that moment passes."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "August Sale \u2014 15% off everything"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Discount applies automatically at checkout. No code needed."
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End date (YYYY-MM-DD)",
      "default": "2026-08-31"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "End time (HH:MM, 24h)",
      "default": "23:59"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding",
      "default": 24
    }
  ],
  "presets": [{ "name": "Countdown bar" }]
}
{% endschema %}
