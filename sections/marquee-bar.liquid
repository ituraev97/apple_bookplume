{%- comment -%}
  Book Plume — scrolling marquee announcement bar.
  Text repeats seamlessly; pauses on hover and respects reduced motion.
{%- endcomment -%}

{%- style -%}
  .bp-marquee-{{ section.id }} {
    overflow: hidden;
    padding: {{ section.settings.padding }}px 0;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.08);
  }

  .bp-marquee__track {
    display: flex;
    width: max-content;
    animation: bp-marquee-scroll {{ section.settings.speed }}s linear infinite;
  }

  .bp-marquee-{{ section.id }}:hover .bp-marquee__track {
    animation-play-state: paused;
  }

  .bp-marquee__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .bp-marquee__track a.bp-marquee__item,
  .bp-marquee__track span.bp-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0 2.4rem;
    font-family: 'IBM Plex Mono', 'Inter', monospace;
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    color: inherit;
  }

  .bp-marquee__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.45;
    flex-shrink: 0;
  }

  .bp-marquee__track .bp-marquee__code {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @keyframes bp-marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bp-marquee__track {
      animation: none;
      justify-content: center;
      width: 100%;
    }
    .bp-marquee__group:nth-child(2) { display: none; }
  }
{%- endstyle -%}

<div class="bp-marquee-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="bp-marquee__track" aria-hidden="false">
    {%- for i in (1..2) -%}
      <div class="bp-marquee__group" {% if i == 2 %}aria-hidden="true"{% endif %}>
        {%- for n in (1..4) -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="bp-marquee__item" {{ block.shopify_attributes }}>
            {%- else -%}
              <span class="bp-marquee__item" {{ block.shopify_attributes }}>
            {%- endif -%}
              <span class="bp-marquee__dot"></span>
              {{ block.settings.text }}
              {%- if block.settings.code != blank -%}
                <span class="bp-marquee__code">{{ block.settings.code }}</span>
              {%- endif -%}
            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </span>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee bar",
  "class": "bp-marquee-section",
  "max_blocks": 4,
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "Scroll duration",
      "info": "Higher is slower.",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over $49"
        },
        {
          "type": "text",
          "id": "code",
          "label": "Highlighted code",
          "info": "Optional. Shown underlined after the text."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee bar",
      "blocks": [
        { "type": "message" }
      ]
    }
  ]
}
{% endschema %}
